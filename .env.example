# Copy this file's variable NAMES into your Vercel project's Environment
# Variables settings (Project Settings -> Environment Variables). Never
# commit real values into this file.

# Your Apify API token (apify.com -> Settings -> Integrations)
APIFY_API_TOKEN=

# Any password you choose -- this gates the whole tool, since it calls
# paid Apify usage on your behalf.
TOOL_PASSWORD=
